                        echo "Channel reduction: ${MAX_CHANNEL_REDUCTION}"
                        
                        # Generate the YAML file
                        python "${YAML_GENERATOR_PATH}" \\
                            --input "${BEST_MODEL_JSON}" \\
                            --output "${OUTPUT_YAML}" \\
                            --classes "${NUM_CLASSES}" \\
                            --reduce "${MAX_CHANNEL_REDUCTION}"
                        
                        if [ $? -eq 0 ] && [ -f "${OUTPUT_YAML}" ]; then
                            echo "✅ Custom YOLOv8 YAML configuration generated successfully!"
                            
                            # Display the generated YAML content (first 50 lines)

def sendNotification(String status, String message) {
    def subject = "${status}: YOLOv8 Pipeline - ${env.JOB_NAME} #${env.BUILD_NUMBER}"
    def buildUrl = "${env.JENKINS_URL}job/${env.JOB_NAME}/${env.BUILD_NUMBER}/"
    
    def htmlBody = """
        <html>
        <body>
            <h2>YOLOv8 Model Optimization Pipeline ${status}</h2>
            
            <h3>Build Information</h3>
            <ul>
                <li><strong>Job:</strong> ${env.JOB_NAME}</li>
                <li><strong>Build:</strong> #${env.BUILD_NUMBER}</li>
                <li><strong>Status:</strong> ${status}</li>
                <li><strong>URL:</strong> <a href="${buildUrl}">${buildUrl}</a></li>

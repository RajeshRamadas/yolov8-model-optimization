        echo "Repository directory: ${MODEL_OPT_REPO}"
        
        # Check if the repository directory exists
        if [ -d "${MODEL_REPO}" ]; then
            echo "Model optimization repository directory already exists, updating it..."
            cd ${MODEL_REPO}
            git pull
            cd ..
        else
            # Clone the model optimization repository
            echo "Downloading YOLOv8 model optimization repository..."
            git clone "${MODEL_REPO_URL}" "${MODEL_REPO}"
        fi
        
        # Verify repository was downloaded
        if [ ! -d "${MODEL_REPO}" ]; then
            echo "Failed to download model optimization repository!"
            exit 1
        fi
        
        # Verify the expected directory structure exists
        if [ -d "${MODEL_REPO}/02-Implementation/dataset_management" ]; then
            echo "Found expected directory structure: ${MODEL_REPO}/02-Implementation/dataset_management"
            ls -la "${MODEL_REPO}/02-Implementation/dataset_management/" | head -10
        else
            echo "Warning: Expected directory structure not found"
            echo "Repository contents:"
            find "${MODEL_REPO}" -type d | head -10
        fi
        
        # Install requirements for the model optimization tools
        cd ${MODEL_REPO}
        if [ -f "requirements.txt" ]; then
            echo "Installing requirements for model optimization..."
            pip install -r requirements.txt
        else
            echo "No requirements.txt found, installing common YOLOv8 dependencies..."
            pip install ultralytics torch torchvision torchaudio
        fi
        
        # Log repository information

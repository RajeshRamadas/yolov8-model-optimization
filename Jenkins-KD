                            # Create failure summary for email
                            cat > "${WORKSPACE}/email_artifacts/s3_upload_failure.txt" << EOF
S3 Upload Failed
===============
Model: ${MODEL_NAME} ${VERSION}
Type: ${BEST_MODEL_TYPE}
Error Code: ${UPLOAD_STATUS}
Upload Date: $(date)
Build: ${BUILD_NUMBER}

Please check the build logs for detailed error information.
Common issues:
- AWS credentials not configured
- S3 bucket permissions
- Network connectivity
- File size limitations
EOF
                            
                            echo "S3 upload failed, but continuing pipeline..."
                        fi
                        
                        # Return to workspace
                        cd "${WORKSPACE}"
                        
                        # Final status
                        echo ""
                        echo "📤 S3 UPLOAD STAGE COMPLETED"
                        echo "Status: $([ ${UPLOAD_STATUS} -eq 0 ] && echo '✅ SUCCESS' || echo '❌ FAILED')"
                        echo "Metadata: ${METADATA_FILE}"
                        echo ""
                    '''
                }
            }
            post {
                always {
                    // Archive S3 upload artifacts
                    archiveArtifacts artifacts: 'artifacts/s3_upload/**', fingerprint: true, allowEmptyArchive: true
                    archiveArtifacts artifacts: 'email_artifacts/s3_upload_*.txt', fingerprint: true, allowEmptyArchive: true
                }
                success {
                    echo "S3 upload stage completed successfully"
                }
                failure {
                    echo "S3 upload stage failed - check logs for details"
                }
            }
        }
		

        
        stage('Generate Reports') {
            steps {
                script {
                    generateReports()
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'artifacts/model_report.html', fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }
    
    post {
        success {
            script {
                sendNotification('SUCCESS', 'Pipeline completed successfully!')
            }
        }
        
        failure {
            script {
                sendNotification('FAILURE', 'Pipeline failed. Check logs for details.')
            }
        }
        
        unstable {
            script {
                sendNotification('UNSTABLE', 'Pipeline completed with warnings.')
            }
        }
        
        cleanup {
            script {
                cleanupWorkspace()
            }
        }
    }
}


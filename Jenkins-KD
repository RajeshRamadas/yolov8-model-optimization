}

def runNeuralArchitectureSearch() {
    sh """
        # Save parameters to environment files for safe parameter passing
        echo "${params.NAS_TRIALS}" > nas_trials.txt
        echo "${params.NAS_EPOCHS}" > nas_epochs.txt
    """
    
    sh '''#!/bin/bash -e
        source "${VENV_NAME}/bin/activate"
        
        # Read parameters from files
        NAS_TRIALS=$(cat nas_trials.txt)
        NAS_EPOCHS=$(cat nas_epochs.txt)
        
        echo "Starting Neural Architecture Search..."
        echo "Trials: ${NAS_TRIALS}, Epochs: ${NAS_EPOCHS}"
        
        # Determine dataset to use (augmented if available, original as fallback)
        AUG_PATH_FILE="${WORKSPACE}/augmentation_dir_path.txt"
        if [ -f "${AUG_PATH_FILE}" ]; then
            AUG_DIR=$(cat "${AUG_PATH_FILE}")
            DATASET_DIR="${AUG_DIR}/augmented_dataset"
            echo "Using augmented dataset: ${DATASET_DIR}"
        else
            DATA_YAML_PATH=$(cat downloads/data_yaml_path.txt)
            DATASET_DIR=$(dirname "${DATA_YAML_PATH}")
            echo "Warning: Using original dataset: ${DATASET_DIR}"
        fi
        
        # Find NAS main.py script
        NAS_MAIN_PATH=$(find ${MODEL_OPT_REPO} -path "*/neural_architecture_search/main.py" -type f | head -n 1)
        if [ -z "${NAS_MAIN_PATH}" ]; then
            echo "ERROR: neural_architecture_search/main.py not found!"
            echo "Available main.py files:"
            find ${MODEL_OPT_REPO} -name "main.py" -type f
            exit 1
        fi
        
        echo "Found NAS main.py at: ${NAS_MAIN_PATH}"
        
        # Find search space configuration
        SEARCH_SPACE_PATH=$(find ${MODEL_OPT_REPO} -name "search_space.yaml" -type f | head -n 1)
        if [ -z "${SEARCH_SPACE_PATH}" ]; then
            echo "WARNING: search_space.yaml not found, trying alternatives..."
            SEARCH_SPACE_PATH=$(find ${MODEL_OPT_REPO} -name "*.yaml" -type f | grep -i "search\\|config" | head -n 1)
        fi
        
        if [ -z "${SEARCH_SPACE_PATH}" ]; then
            echo "WARNING: No search space config found, using default parameters"
            SEARCH_SPACE_ARG=""
        else
            echo "Found search space config at: ${SEARCH_SPACE_PATH}"
            SEARCH_SPACE_ARG="--config ${SEARCH_SPACE_PATH}"
        fi
        
        # Verify dataset YAML file
        DATASET_YAML="${DATASET_DIR}/data.yaml"
        if [ ! -f "${DATASET_YAML}" ]; then
            DATASET_YAML="${DATASET_DIR}/dataset.yaml"
            if [ ! -f "${DATASET_YAML}" ]; then
                DATASET_YAML="${WORKSPACE_ARTIFACTS}/augmented_data.yaml"
                if [ ! -f "${DATASET_YAML}" ]; then
                    echo "ERROR: Cannot find dataset YAML file!"
                    exit 1
                fi
            fi
        fi
        
        echo "Using dataset YAML: ${DATASET_YAML}"
        
        # Create results directory
        mkdir -p "${WORKSPACE}/thorough_nas"
        
        # Log timing information
        echo "NAS Start Time: $(date)" > "${WORKSPACE_ARTIFACTS}/nas_timing.txt"
        echo "Parameters: ${NAS_TRIALS} trials, ${NAS_EPOCHS} epochs" >> "${WORKSPACE_ARTIFACTS}/nas_timing.txt"
        
        # Run Neural Architecture Search
        echo "Executing Neural Architecture Search..."
        cd "$(dirname ${NAS_MAIN_PATH})"
        
        # Build command with optional parameters
        NAS_CMD="python main.py --data ${DATASET_YAML} --trials ${NAS_TRIALS} --epochs ${NAS_EPOCHS} --results-dir ${WORKSPACE}/thorough_nas"
        
        # Add optional parameters if available
        if [ -n "${SEARCH_SPACE_ARG}" ]; then
            NAS_CMD="${NAS_CMD} ${SEARCH_SPACE_ARG}"
        fi
        
        # Add additional parameters if supported
        NAS_CMD="${NAS_CMD} --parallel 2 --objective combined --advanced-search"
        
        echo "Running command: ${NAS_CMD}"
        
        # Execute with timeout and error handling
        if timeout 7200 ${NAS_CMD}; then
            echo "NAS completed successfully"
        else
            echo "NAS completed with timeout or error, but continuing..."
        fi
        
        # Log completion time
        echo "NAS End Time: $(date)" >> "${WORKSPACE_ARTIFACTS}/nas_timing.txt"
        
        # Process results
        cd "${WORKSPACE}/thorough_nas"
        
        # Create best models summary if results exist
        if [ -f "all_results.csv" ]; then
            echo "Creating best models summary..."
            echo "Top 3 Models by Combined Score:" > "${WORKSPACE_ARTIFACTS}/best_models.txt"
            head -n 1 "all_results.csv" >> "${WORKSPACE_ARTIFACTS}/best_models.txt"
            tail -n +2 "all_results.csv" | sort -t, -k10 -nr | head -n 3 >> "${WORKSPACE_ARTIFACTS}/best_models.txt"
        else
            echo "No results CSV found, creating basic summary..."
            echo "NAS execution completed but no results CSV generated" > "${WORKSPACE_ARTIFACTS}/best_models.txt"
            echo "Results directory contents:" >> "${WORKSPACE_ARTIFACTS}/best_models.txt"
            ls -la "${WORKSPACE}/thorough_nas" >> "${WORKSPACE_ARTIFACTS}/best_models.txt"
        fi
        
        # Create email-friendly results package
        echo "Packaging results for email..."
        mkdir -p email_summary
        
        # Copy lightweight files
        cp -f *.csv email_summary/ 2>/dev/null || true
        cp -f *.json email_summary/ 2>/dev/null || true
        cp -f *.html email_summary/ 2>/dev/null || true
        cp -f *.txt email_summary/ 2>/dev/null || true
        
        # Copy visualizations if they exist
        if [ -d "visualizations" ]; then
            cp -r visualizations email_summary/ || true
        fi
        
        # Create email summary ZIP
        cd email_summary
        if [ "$(ls -A .)" ]; then
            zip -r nas_results_summary.zip ./*
            cp nas_results_summary.zip "${WORKSPACE}/email_artifacts/"
            echo "Email summary created successfully"
        else
            echo "No results files found for email summary"
            echo "NAS completed but no summary files generated" > nas_summary.txt
            zip nas_results_summary.zip nas_summary.txt
            cp nas_results_summary.zip "${WORKSPACE}/email_artifacts/"
        fi
        
        # Create model size report
        cd "${WORKSPACE}/thorough_nas"
        if [ -f "*.pt" ]; then
            find . -name "*.pt" -type f | xargs du -h | sort -hr > "${WORKSPACE_ARTIFACTS}/model_sizes.txt"
        else
            echo "No model files (.pt) found" > "${WORKSPACE_ARTIFACTS}/model_sizes.txt"
        fi
        
        echo "Neural Architecture Search stage completed successfully"
    '''
}


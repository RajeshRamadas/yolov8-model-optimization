def downloadDataset() {
    sh '''#!/bin/bash -e
        source "${VENV_NAME}/bin/activate"
        cd "${WORKSPACE_DOWNLOADS}"
        
        # Check if we should force download or if dataset doesn't exist
        if [ "${FORCE_DOWNLOAD}" = "true" ]; then
            echo "Force download enabled - removing existing files..."
            rm -f "${DATASET_ZIP}"
            rm -rf "${DATASET_DIR}"
        elif [ -f "${DATASET_ZIP}" ] && [ -d "${DATASET_DIR}" ]; then
            # Check if existing file is valid before skipping
            if unzip -t "${DATASET_ZIP}" >/dev/null 2>&1; then
                echo "Valid dataset already exists, skipping download"
                echo "To force re-download, set FORCE_DOWNLOAD parameter to true"
                exit 0
            else
                echo "Existing dataset file is corrupted, re-downloading..."
                rm -f "${DATASET_ZIP}"
                rm -rf "${DATASET_DIR}"
            fi
        fi
        
        # Validate parameters
        if [ -z "${GDRIVE_FILE_ID}" ] && [ -z "${DATASET_URL}" ]; then
            echo "ERROR: Both GDRIVE_FILE_ID and DATASET_URL are empty!"
            echo "Please provide either:"
            echo "1. A valid Google Drive file ID, or"
            echo "2. A direct download URL (HTTP/HTTPS)"
            exit 1
        fi
        
        echo "Download parameters:"
        echo "Google Drive File ID: '${GDRIVE_FILE_ID}'"
        echo "Alternative URL: '${DATASET_URL}'"
        
        # Try Google Drive download first (if file ID is provided)
        if [ -n "${GDRIVE_FILE_ID}" ]; then
            echo "Installing gdown for Google Drive downloads..."
            pip install gdown
            
            echo "Attempting Google Drive download..."
            echo "File ID: ${GDRIVE_FILE_ID}"
            
            # Method 1: Try with gdown using --fuzzy flag
            echo "Attempting download with gdown (method 1)..."
            if python -m gdown "https://drive.google.com/uc?id=${GDRIVE_FILE_ID}" -O "${DATASET_ZIP}" --fuzzy; then
                echo "Download completed with gdown"
                DOWNLOAD_SUCCESS=true
            else
                echo "gdown failed, trying curl method..."
                rm -f "${DATASET_ZIP}"
                
                # Method 2: Try direct download URL format
                echo "Attempting direct Google Drive download with curl (method 2)..."
                if curl -L "https://drive.google.com/uc?export=download&id=${GDRIVE_FILE_ID}" -o "${DATASET_ZIP}"; then
                    echo "Download completed with curl"
                    DOWNLOAD_SUCCESS=true
                else
                    echo "Google Drive download failed with both methods"
                    DOWNLOAD_SUCCESS=false
                fi
            fi
        else
            echo "No Google Drive file ID provided, skipping Google Drive download"
            DOWNLOAD_SUCCESS=false
        fi
        
        # If Google Drive failed and we have an alternative URL, try that
        if [ "${DOWNLOAD_SUCCESS}" != "true" ] && [ -n "${DATASET_URL}" ]; then
            echo "Trying alternative download URL..."
            rm -f "${DATASET_ZIP}"
            
            if curl -L "${DATASET_URL}" -o "${DATASET_ZIP}"; then
                echo "Download completed from alternative URL"
                DOWNLOAD_SUCCESS=true
            else
                echo "Alternative URL download also failed"
                DOWNLOAD_SUCCESS=false
            fi
        fi
        
        # Check if any download method succeeded
        if [ "${DOWNLOAD_SUCCESS}" != "true" ]; then
            echo "ERROR: All download methods failed!"
            echo ""
            echo "Troubleshooting steps:"
            echo "1. Verify Google Drive file ID: ${GDRIVE_FILE_ID}"
            echo "2. Check Google Drive file permissions (Anyone with link can view)"
            echo "3. Try providing alternative DATASET_URL parameter"
            echo "4. Ensure file exists and is accessible"
            exit 1
        fi
        
        # Validate downloaded file
        if [ ! -f "${DATASET_ZIP}" ]; then
            echo "ERROR: Download failed - file not created!"
            exit 1
        fi
        
        # Check file size
        FILE_SIZE=$(stat -c%s "${DATASET_ZIP}")
        echo "Downloaded file size: ${FILE_SIZE} bytes"
        
        if [ "${FILE_SIZE}" -lt 10240 ]; then
            echo "ERROR: Downloaded file is too small (${FILE_SIZE} bytes)"
            echo "File type: $(file ${DATASET_ZIP})"
            echo ""
            echo "File contents (first 5 lines):"
            head -n 5 "${DATASET_ZIP}"
            echo ""
            echo "This usually indicates:"
            echo "1. File ID is incorrect: '${GDRIVE_FILE_ID}'"
            echo "2. File is not publicly accessible"
            echo "3. Google Drive requires authentication"
            echo "4. File does not exist"
            echo ""
            echo "SOLUTIONS:"
            echo "1. Check Google Drive file sharing: 'Anyone with the link can view'"
            echo "2. Verify file ID from share URL: https://drive.google.com/file/d/FILE_ID/view"
            echo "3. Try alternative download URL in DATASET_URL parameter"
            exit 1
        fi
        
        # Check file type - should not be HTML
        FILE_TYPE=$(file "${DATASET_ZIP}")
        if echo "${FILE_TYPE}" | grep -i "html\\|text" >/dev/null; then
            echo "ERROR: Downloaded file is HTML/text, not a ZIP archive"
            echo "File type: ${FILE_TYPE}"
            echo ""
            echo "This means the download returned an error page instead of the file."
            echo "Please check:"
            echo "1. Google Drive file permissions"
            echo "2. File ID accuracy: '${GDRIVE_FILE_ID}'"
            echo "3. Try alternative DATASET_URL parameter"
            exit 1
        fi
        
        # Verify ZIP file integrity
        if ! unzip -t "${DATASET_ZIP}" >/dev/null 2>&1; then
            echo "ERROR: Downloaded file is not a valid ZIP archive"
            echo "File size: ${FILE_SIZE} bytes"
            echo "File type: ${FILE_TYPE}"
            exit 1
        fi
        
        echo "Dataset downloaded successfully: $(ls -lh ${DATASET_ZIP})"
        echo "File verified as valid ZIP archive"
    '''
}

def processDataset() {
    sh '''#!/bin/bash -e
        cd "${WORKSPACE_DOWNLOADS}"
        
        # Verify ZIP file exists and is valid
        if [ ! -f "${DATASET_ZIP}" ]; then
            echo "ERROR: Dataset ZIP file not found!"
            exit 1
        fi
        
        echo "Verifying ZIP file integrity..."
        if ! unzip -t "${DATASET_ZIP}"; then
            echo "ERROR: ZIP file is corrupted or invalid!"
            echo "File size: $(stat -c%s ${DATASET_ZIP}) bytes"
            echo "File type: $(file ${DATASET_ZIP})"
            exit 1
        fi
        
        echo "Extracting dataset..."
        mkdir -p "${DATASET_DIR}"
        
        # Extract with verbose output to help debugging
        if ! unzip -o "${DATASET_ZIP}" -d "${DATASET_DIR}"; then
            echo "ERROR: Failed to extract dataset!"
            exit 1
        fi
        
        echo "Locating data.yaml file..."
        DATA_YAML_PATH=$(find "${DATASET_DIR}" -name "data.yaml" -type f | head -n 1)
        
        if [ -z "${DATA_YAML_PATH}" ]; then
            echo "ERROR: data.yaml not found in dataset!"
            echo "Available files in dataset:"
            find "${DATASET_DIR}" -type f | head -20
            exit 1
        fi
        
        # Save absolute path
        readlink -f "${DATA_YAML_PATH}" > "${DATA_YAML_FILE}"
        
        echo "Dataset processed successfully"
        echo "data.yaml location: $(cat ${DATA_YAML_FILE})"
        
        # Validate dataset structure
        echo "Dataset validation:"
        head -n 10 "$(cat ${DATA_YAML_FILE})"
        
        echo "Dataset directory structure:"
        ls -la "${DATASET_DIR}"
    '''
}

def setupModelRepository() {
    sh '''#!/bin/bash -e
        source "${VENV_NAME}/bin/activate"
        
        echo "Setting up model optimization repository..."
        echo "Repository URL: ${MODEL_REPO_URL}"
        echo "Repository directory: ${MODEL_OPT_REPO}"
        
        # Check if the repository directory exists
        if [ -d "${MODEL_REPO}" ]; then
            echo "Model optimization repository directory already exists, updating it..."
            cd ${MODEL_REPO}
            git pull
            cd ..
        else
            # Clone the model optimization repository
            echo "Downloading YOLOv8 model optimization repository..."
            git clone "${MODEL_REPO_URL}" "${MODEL_REPO}"
        fi
        
        # Verify repository was downloaded
        if [ ! -d "${MODEL_REPO}" ]; then
            echo "Failed to download model optimization repository!"
            exit 1
        fi
        
        # Verify the expected directory structure exists
        if [ -d "${MODEL_REPO}/02-Implementation/dataset_management" ]; then
            echo "Found expected directory structure: ${MODEL_REPO}/02-Implementation/dataset_management"
            ls -la "${MODEL_REPO}/02-Implementation/dataset_management/" | head -10
        else
            echo "Warning: Expected directory structure not found"
            echo "Repository contents:"
            find "${MODEL_REPO}" -type d | head -10
        fi
        
        # Install requirements for the model optimization tools
        cd ${MODEL_REPO}
        if [ -f "requirements.txt" ]; then
            echo "Installing requirements for model optimization..."
            pip install -r requirements.txt
        else
            echo "No requirements.txt found, installing common YOLOv8 dependencies..."
            pip install ultralytics torch torchvision torchaudio
        fi
        
        # Log repository information
        echo "Repository information:"
        git log -1 --pretty=format:"Last commit: %h by %an (%ad) - %s"
        
        cd ..
        echo "Model optimization repository setup complete."
        
        # Create a file listing all Python files for documentation
        mkdir -p "${WORKSPACE_ARTIFACTS}"
        echo "Repository: ${MODEL_REPO_URL}" > "${WORKSPACE_ARTIFACTS}/model_repo_info.txt"
        echo "Last commit: $(cd ${MODEL_REPO} && git log -1 --pretty=format:'%h by %an (%ad) - %s')" >> "${WORKSPACE_ARTIFACTS}/model_repo_info.txt"
        echo "Python files: $(find ${MODEL_REPO} -name '*.py' | wc -l)" >> "${WORKSPACE_ARTIFACTS}/model_repo_info.txt"
        
        # FIX: Use explicit output redirection with proper variable expansion
        find "${MODEL_REPO}" -type f -name "*.py" | sort > "${WORKSPACE_ARTIFACTS}/model_optimization_files.txt"
        
        # Specifically list dataset management files
        echo "Dataset management Python files:" >> "${WORKSPACE_ARTIFACTS}/model_repo_info.txt"
        find "${MODEL_REPO}/02-Implementation/dataset_management" -name "*.py" 2>/dev/null >> "${WORKSPACE_ARTIFACTS}/model_repo_info.txt" || echo "Dataset management directory not found" >> "${WORKSPACE_ARTIFACTS}/model_repo_info.txt"
    '''
}



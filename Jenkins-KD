                            cat > "${WORKSPACE_ARTIFACTS}/model_configs/generation_summary.txt" << EOF
Custom YOLOv8 Configuration Generation Summary
============================================
Generated: $(date)
Input JSON: ${BEST_MODEL_JSON}
Output YAML: ${OUTPUT_YAML}
Number of Classes: ${NUM_CLASSES}
Channel Reduction: ${MAX_CHANNEL_REDUCTION}
Generator Script: ${YAML_GENERATOR_PATH}

Configuration Status: SUCCESS
EOF
                            
                            # Copy to email artifacts for notification
                            cp "${OUTPUT_YAML}" "${WORKSPACE}/email_artifacts/"
                            cp "${WORKSPACE_ARTIFACTS}/model_configs/generation_summary.txt" "${WORKSPACE}/email_artifacts/"
                            
                            echo "Custom YOLOv8 configuration generation completed successfully!"
                        else
                            echo "❌ Failed to generate custom YOLOv8 YAML configuration"
                            exit 1
                        fi
                    '''
                }
